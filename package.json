{
  "name": "@cocreate/turso",
  "version": "2.0.2",
  "description": "Lightweight Turso CRUD wrapper and multi-tenant state routing client for the CoCreate ecosystem.",
  "keywords": [
    "turso",
    "sqlite3",
    "sql",
    "json",
    "crud-api",
    "abstract-crud",
    "database-abstraction",
    "multi-tenant",
    "multi-tenant-routing",
    "realtime-sync",
    "state-synchronization",
    "state-routing",
    "embedded-replicas"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "webpack --config webpack.config.js",
    "build": "webpack --mode=production --config webpack.config.js",
    "dev": "webpack --config webpack.config.js --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CoCreateJS/turso.git"
  },
  "author": "CoCreate LLC",
  "license": "AGPL-3.0",
  "bugs": {
    "url": "https://github.com/CoCreateJS/turso/issues"
  },
  "homepage": "https://CoCreateJS.com/docs/turso",
  "funding": {
    "type": "GitHub Sponsors ❤",
    "url": "https://github.com/sponsors/CoCreateJS"
  },
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./dist": "./dist/turso.js"
  },
  "devDependencies": {
    "@cocreate/webpack": "^2.0.1"
  },
  "dependencies": {
    "@cocreate/sqlite": "^2.0.1",
    "@cocreate/utils": "^2.0.2"
  }
}
