{
  "name": "@cocreate/turso",
  "version": "1.5.0",
  "description": "Lightweight Turso CRUD wrapper and multi-tenant state routing client for the CoCreate ecosystem.",
  "keywords": [
    "turso",
    "sqlite3",
    "sql",
    "json",
    "crud-api",
    "abstract-crud",
    "database-abstraction",
    "multi-tenant",
    "multi-tenant-routing",
    "realtime-sync",
    "state-synchronization",
    "state-routing",
    "embedded-replicas"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "webpack --config webpack.config.js",
    "build": "webpack --mode=production --config webpack.config.js",
    "dev": "webpack --config webpack.config.js --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/cocreatejs/CoCreate-turso.git"
  },
  "author": "CoCreate LLC",
  "license": "AGPL-3.0",
  "bugs": {
    "url": "https://github.com/CoCreate-app/CoCreate-turso/issues"
  },
  "homepage": "https://cocreate.app/docs/turso",
  "funding": {
    "type": "GitHub Sponsors ❤",
    "url": "https://github.com/sponsors/CoCreate-app"
  },
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./dist": "./dist/turso.js",
    "./installer": "./installer/turso.installer.js"
  },
  "devDependencies": {
    "@cocreate/webpack": "^1.9.0"
  },
  "dependencies": {
    "@cocreate/sqlite": "^1.6.0",
    "@cocreate/utils": "^1.54.0"
  }
}
